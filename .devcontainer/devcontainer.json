{
	"name": "Ubuntu",
	"build": {
		"dockerfile": "Dockerfile"
	},

	"features": {
		// Install GitHub CLI and Claude Code
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/stu-bell/devcontainer-features/claude-code:0": {}
	},

	"remoteUser": "vscode",

	// Enable hardware performance counters for perf stat
	"runArgs": [
		"--cap-add=SYS_PTRACE",
		"--cap-add=SYS_ADMIN",
		"--security-opt", "seccomp=unconfined"
	]
}
